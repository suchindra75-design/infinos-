NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:password@localhost:5432/infinos

JWT_SECRET=replace_later
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_later

THINGSPEAK_BASE_URL=https://api.thingspeak.com

SYNC_INTERVAL_MS=15000
DEVICE_ONLINE_THRESHOLD_SECONDS=60
DEVICE_STALE_THRESHOLD_SECONDS=180
INITIAL_BACKFILL_LIMIT=20
INCREMENTAL_SYNC_LIMIT=10
ENABLE_SYNC_WORKER=true

CORS_ORIGIN=http://localhost:5173
